# ── Dependencies (rebuilt by `npm install`) ─────────────
node_modules/

# ── Build output (rebuilt by `npm run build`) ───────────
dist/
build/
.vite/

# ── Secrets & environment variables — NEVER commit these
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx

# ── Logs & caches ───────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.cache/
coverage/

# ── Editor / IDE personal files ─────────────────────────
# Ignore .vscode except the two files we share with the team
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.vs/
*.suo
*.user

# ── Operating system junk ───────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Temporary files ─────────────────────────────────────
*.tmp
*.temp